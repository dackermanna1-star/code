{
  "name": "godline",
  "private": true,
  "version": "1.0.0",
  "description": "GODLINE \u2014 an endlessly replayable, cinematic, AI-driven duel of godlike stick-figure warriors.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "balance": "tsx tools/balance.ts",
    "fight": "tsx tools/fight.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
