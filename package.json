{
  "name": "corrode",
  "version": "0.1.0",
  "private": true,
  "description": "CORRODE - a singleplayer voxel survival sandbox: block-world freedom, hardcore survival, base building and raiding. Runs entirely in the browser.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && node scripts/e2e-smoke.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}