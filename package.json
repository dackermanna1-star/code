{
  "name": "sizzle-and-stack",
  "private": true,
  "version": "1.0.0",
  "description": "Sizzle & Stack — a 3D burger-shop management game built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "~0.186.1"
  },
  "devDependencies": {
    "@types/three": "~0.186.0",
    "playwright-core": "1.56.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
