{
  "name": "voxelcraft-photoreal",
  "private": true,
  "version": "0.1.0",
  "description": "Private, non-commercial fan recreation of Minecraft with a modern photorealistic deferred renderer and realistic physics, running in the browser (WebGL2).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shot": "node tools/screenshot.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "0.186.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
