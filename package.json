{
  "name": "apartment-destruction-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fully destructible high-rise apartment destruction sandbox built on the Babylon.js game engine with Havok physics.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test tests/unit",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.30.0",
    "@babylonjs/havok": "1.3.14"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
