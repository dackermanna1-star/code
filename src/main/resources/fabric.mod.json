{
	"schemaVersion": 1,
	"id": "ordnance",
	"version": "${version}",
	"name": "Ordnance",
	"description": "Realistic explosions, dynamic fire and a modern arsenal: hand grenades, RPG-7, flamethrower, grenade launcher and hypersonic missile strikes.",
	"authors": ["Ordnance contributors"],
	"contact": {},
	"license": "MIT",
	"icon": "assets/ordnance/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["com.ordnance.Ordnance"],
		"client": ["com.ordnance.client.OrdnanceClient"]
	},
	"mixins": [
		"ordnance.mixins.json",
		{
			"config": "ordnance.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
