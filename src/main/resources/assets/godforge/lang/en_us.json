  "item.godforge.laser_beam.title": "Annihilation Cannon",
  "item.godforge.laser_beam.lore1": "A continuous beam that burns, melts, vaporizes",
  "item.godforge.laser_beam.lore2": "or detonates whatever it touches. Tune its power,",
  "item.godforge.laser_beam.lore3": "width, range, intensity and colour with [G].",
