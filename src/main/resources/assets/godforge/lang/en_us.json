  "item.godforge.asteroid_gun": "The Asteroid Gun",
  "item.godforge.asteroid_gun.title": "Planetfall",
  "item.godforge.asteroid_gun.lore1": "Tap to designate a target. Hold to charge,",
  "item.godforge.asteroid_gun.lore2": "release to call an asteroid down from the heavens.",
  "item.godforge.asteroid_gun.lore3": "Charge decides how much of the world it ends.",
  "death.attack.godforge.asteroid_gun": "%1$s was flattened by an asteroid",
  "death.attack.godforge.asteroid_gun.player": "%1$s was flattened by an asteroid summoned by %2$s",
  "item.godforge.black_hole": "The Black Hole",
  "item.godforge.black_hole.title": "Event Horizon",
  "item.godforge.black_hole.lore1": "Launches a singularity that drags in creatures,",
  "item.godforge.black_hole.lore2": "items and the very terrain, growing with every meal,",
  "item.godforge.black_hole.lore3": "until it collapses in a cataclysmic release.",
  "death.attack.godforge.black_hole": "%1$s crossed the event horizon",
  "death.attack.godforge.black_hole.player": "%1$s was spaghettified by %2$s's singularity",
  "item.godforge.reality_breaker": "The Reality Breaker",
  "item.godforge.reality_breaker.title": "Dimensional Collapse",
  "item.godforge.reality_breaker.lore1": "Shatters the land into floating fragments and",
  "item.godforge.reality_breaker.lore2": "tears rifts into other dimensions. Its ultimate",
  "item.godforge.reality_breaker.lore3": "spreads the collapse across the landscape.",
  "death.attack.godforge.reality_breaker": "%1$s fell through a crack in reality",
  "death.attack.godforge.reality_breaker.player": "%1$s was torn out of reality by %2$s",
  "item.godforge.starfall_bow": "The Starfall Bow",
  "item.godforge.starfall_bow.title": "Celestial Judgment",
  "item.godforge.starfall_bow.lore1": "Looses miniature stars. Draw longer to call a",
  "item.godforge.starfall_bow.lore2": "meteor shower; in Judgment mode, a full draw",
  "item.godforge.starfall_bow.lore3": "brings a gigantic star down upon the land.",
  "death.attack.godforge.starfall_bow": "%1$s was struck down by a falling star",
  "death.attack.godforge.starfall_bow.player": "%1$s received celestial judgment from %2$s",
  "item.godforge.godfist": "The Godfist",
  "item.godforge.godfist.title": "Fist of Absolute Destruction",
  "item.godforge.godfist.lore1": "Every punch is a kinetic event: foes fly across",
  "item.godforge.godfist.lore2": "the horizon and shatter the ground they land on.",
  "item.godforge.godfist.lore3": "Charge to project giant fists, or slam the world.",
  "death.attack.godforge.godfist": "%1$s was punched into orbit",
  "death.attack.godforge.godfist.player": "%1$s was punched into orbit by %2$s",
